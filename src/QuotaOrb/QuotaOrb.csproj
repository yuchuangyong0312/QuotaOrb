<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><AssemblyName>QuotaOrb</AssemblyName><RootNamespace>QuotaOrb</RootNamespace>
    <Version>2.1.17</Version><RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QuotaOrb.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\QuotaOrb.Core\QuotaOrb.Core.csproj"/><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12"/></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\QuotaOrb.ico"/>
    <Resource Include="Assets\QuotaOrb.png"/>
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="QuotaOrb.Licenses.NOTICES"/>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="QuotaOrb.Licenses.QuotaOrb-MIT"/>
    <EmbeddedResource Include="..\..\licenses\*.txt" LogicalName="QuotaOrb.Licenses.%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
